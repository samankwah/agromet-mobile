{
  "expo": {
    "name": "AgroMet Ghana",
    "slug": "agromet-ghana",
    "scheme": "agromet",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agromet.ghana"
    },
    "android": {
      "package": "com.agromet.ghana",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#ffffff"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AgroMet Ghana uses the camera to photograph crops for diagnosis."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AgroMet Ghana accesses your photos so you can attach a crop photo for diagnosis."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgroMet Ghana can use your location to suggest the nearest town for weather and alerts."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#145e49",
          "defaultChannel": "reminders",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "AgroMet Ghana uses the microphone so you can ask a question by speaking instead of typing."
        }
      ],
      "react-native-fast-tflite",
      "expo-sharing",
      "expo-status-bar",
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a713d46-adac-4cc4-b307-70aaaf115c54"
      }
    },
    "owner": "byteshiftlab"
  }
}
