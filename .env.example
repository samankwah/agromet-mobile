# Copy this file to .env and adjust as needed.
#
# Expo only exposes client-side env vars that are prefixed with
# EXPO_PUBLIC_ (unlike the web app's Vite-based VITE_ prefix) — anything
# without that prefix is invisible to app code.
#
# Read by shared/api/apiConfig.ts, which backs the calendar feature's HTTP
# calls. Leave it unset and the app derives the host from the Expo dev
# server the bundle came from, which is reachable from an emulator or a
# physical phone; `localhost` is not. Set it explicitly to point at a
# deployed backend.
#
# Note that Expo inlines EXPO_PUBLIC_* at bundle time, so changing this
# needs `npx expo start -c` to take effect.
#
# The other shared/api/*Service.ts functions still read local mock data.
EXPO_PUBLIC_API_URL=http://localhost:8000

# The desk that takes market orders, in full international form without a
# leading +. Unset, the market screens hide ordering rather than opening an
# empty WhatsApp compose window. Read by shared/utils/buildMarketOrderText.ts.
EXPO_PUBLIC_MARKET_WHATSAPP=

# The public AgroMet website. The app menu's Terms and Privacy rows open
# /terms and /privacy there rather than duplicating the legal copy, so the
# site stays the single source of truth. Unset, those rows say so instead of
# opening a broken link. Read by shared/config/links.ts.
EXPO_PUBLIC_SITE_URL=

# Where "Contact Us" in the app menu goes. Email is preferred over phone —
# it keeps the question and the reply in one thread. Either may be set;
# with neither, the row says contact is not configured.
EXPO_PUBLIC_CONTACT_EMAIL=
EXPO_PUBLIC_CONTACT_PHONE=

# Crash reporting. Read by shared/monitoring/sentry.ts, which stays off
# entirely while this is unset, and in development whatever it is set to.
#
# For a release build it belongs in the preview and production profiles in
# eas.json, alongside EXPO_PUBLIC_API_URL. EAS rejects an empty value there, so
# add the key only once you have a real DSN. Source map upload also stays off
# (SENTRY_DISABLE_AUTO_UPLOAD) until a Sentry auth token exists, without which
# a crash's stack trace is unreadable.
EXPO_PUBLIC_SENTRY_DSN=
