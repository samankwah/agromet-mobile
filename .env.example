# Copy this file to .env and adjust as needed.
#
# Expo only exposes client-side env vars that are prefixed with
# EXPO_PUBLIC_ (unlike the web app's Vite-based VITE_ prefix) — anything
# without that prefix is invisible to app code.
#
# Read by shared/api/apiConfig.ts, which backs the calendar feature's HTTP
# calls. Leave it unset and the app derives the host from the Expo dev
# server the bundle came from, which is reachable from an emulator or a
# physical phone; `localhost` is not. Set it explicitly to point at a
# deployed backend.
#
# Note that Expo inlines EXPO_PUBLIC_* at bundle time, so changing this
# needs `npx expo start -c` to take effect.
#
# The other shared/api/*Service.ts functions still read local mock data.
EXPO_PUBLIC_API_URL=http://localhost:8000

# The desk that takes market orders, in full international form without a
# leading +. Unset, the market screens hide ordering rather than opening an
# empty WhatsApp compose window. Read by shared/utils/buildMarketOrderText.ts.
EXPO_PUBLIC_MARKET_WHATSAPP=
